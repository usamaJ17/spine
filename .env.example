# Copy this file to .env on the server and edit it.
# .env is git-ignored and blocked from the web by .htaccess.
# Anything left out falls back to lib/config.php.

APP_NAME="Spine"
TAGLINE="A circle of people worth knowing."

# ---------------------------------------------------------------- database
# sqlite (default, recommended) | mysql
DB_DRIVER=sqlite

# Where the SQLite file lives. Relative paths resolve against the app
# folder — the default keeps it in data/, right alongside everything else.
# .htaccess blocks data/ from the web; check /admin.php after deploying to
# confirm that's actually true on your host.
DB_PATH=data/spine.sqlite

# Only needed when DB_DRIVER=mysql
#DB_HOST=localhost
#DB_PORT=3306
#DB_NAME=spine
#DB_USER=spine
#DB_PASS=

# ------------------------------------------------------------------ secret
# Signs the sign-in cookies. Leave it blank and one is generated into
# data/secret.key — but set it here on a server you redeploy to, so a deploy
# that replaces the folder does not sign everybody out. Generate one with:
#
#   php -r "echo bin2hex(random_bytes(32));"
#
#APP_SECRET=

# -------------------------------------------------------------------- mail
# Sends an email to the other person whenever a spark is created.
# Leave MAIL_HOST blank to turn notifications off entirely.
#
# Hostinger: use your full mailbox address as the username, port 465.
# There is a "Send test email" button in /admin.php to check it works.
#
#MAIL_HOST=smtp.hostinger.com
#MAIL_PORT=465                      # 465 = SSL, 587 = STARTTLS
#MAIL_USER=spine@yourdomain.com
#MAIL_PASS=
#MAIL_FROM=spine@yourdomain.com     # defaults to MAIL_USER
#MAIL_FROM_NAME=Spine

# -------------------------------------------------------------------- cron
# Secret for cron.php, which closes finished rounds and sends the digest.
# Generate one:  php -r "echo bin2hex(random_bytes(16));"
# Then in hPanel -> Advanced -> Cron Jobs, once a day:
#   curl -s "https://yourdomain.com/cron.php?key=THE_SAME_VALUE"
# Leave blank and the HTTP endpoint stays closed (404) — the schedule still
# runs whenever somebody opens the app, just less punctually.
#CRON_KEY=

# ------------------------------------------------------------------- misc
# Set only if magic links come out with the wrong host (proxy or CDN).
#BASE_URL=https://spine.example.com

# How long a person stays signed in on one device.
COOKIE_DAYS=365
